<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>UAE Medical Jobs</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/static/css/style.css" />
</head>
<body>
  <header class="site-header">
    <div class="site-header__inner">
      <div class="site-brand">
        <h1 class="site-brand__title">UAE Medical Jobs</h1>
        <p class="site-brand__tag">Healthcare roles from public and private employers across the Emirates</p>
      </div>
    </div>
  </header>

  <main class="layout">
    <section class="intro" aria-labelledby="intro-heading">
      <h2 id="intro-heading" class="intro__title">Find your next role</h2>
      <p class="intro__lead">
        Search and filter vacancies aggregated from employer career portals. Apply on the official site for each listing.
      </p>
      <div class="intro__stats">
        <span class="stat-chip"><strong>{{ total_jobs }}</strong> open roles</span>
        <span class="stat-chip"><strong>{{ hospital_counts | length }}</strong> employers</span>
        <span class="stat-chip"><strong>{{ city_counts | length }}</strong> locations</span>
      </div>
    </section>

    <form method="get" id="jobFilterForm" class="toolbar" action="/">
      <div class="search-combobox" id="searchCombobox">
        <div class="search-field">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="M21 21l-4.35-4.35" />
          </svg>
          <input
            type="search"
            name="q"
            id="qInput"
            placeholder="Search by job title, employer, or location…"
            value="{{ query | default('') }}"
            autocomplete="off"
            role="combobox"
            aria-expanded="false"
            aria-controls="suggestDropdown"
            aria-autocomplete="list"
          />
          <button type="button" class="search-clear" id="clearSearchBtn" aria-label="Clear search">×</button>
        </div>
        <div class="suggest-dropdown" id="suggestDropdown" role="listbox" hidden></div>
      </div>

      {% if active_filters | length %}
      <div class="active-filters" aria-label="Active filters">
        {% for chip in active_filters %}
          <a class="filter-chip" href="{{ chip.removeHref }}">
            <span>{{ chip.label }}</span>
            <span class="filter-chip__x" aria-hidden="true">×</span>
          </a>
        {% endfor %}
        <a class="filter-chip filter-chip--clear" href="{{ clear_all_href }}">Clear all</a>
      </div>
      {% endif %}

      {% if location_pills | length %}
      <div class="quick-filters">
        <span class="quick-filters__label">Popular locations</span>
        <div class="quick-filters__pills">
          {% for pill in location_pills %}
            <a class="quick-pill{% if pill.active %} is-active{% endif %}" href="{{ pill.href }}">
              {{ pill.label }}
              <span class="quick-pill__count">{{ pill.count }}</span>
            </a>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      <div class="filter-row">
        <button type="button" class="btn-filter-toggle" id="toggleFiltersBtn" aria-expanded="{{ 'true' if filters_open else 'false' }}" aria-controls="filtersPanel">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h7" />
          </svg>
          More filters &amp; sort
        </button>
        <button type="submit" class="btn btn--primary btn--compact">Search</button>
      </div>

      <div id="filtersPanel" class="filters-panel{% if filters_open %} is-open{% endif %}">
        <div class="filters-grid">
          <div class="field field--searchable">
            <label for="employerFilterSearch">Employer</label>
            <input type="search" id="employerFilterSearch" class="filter-search" placeholder="Filter employer list…" autocomplete="off" />
            <select id="filter-hospital" name="hospital" size="1">
              <option value="" {% if not hospital %}selected{% endif %}>All employers ({{ total_jobs }})</option>
              {% for h in hospital_counts %}
                <option value="{{ h.hospital_name }}" {% if hospital == h.hospital_name %}selected{% endif %}>
                  {{ h.hospital_name }} ({{ h.total }})
                </option>
              {% endfor %}
            </select>
          </div>
          <div class="field field--searchable">
            <label for="locationFilterSearch">Location</label>
            <input type="search" id="locationFilterSearch" class="filter-search" placeholder="Filter location list…" autocomplete="off" />
            <select id="filter-city" name="city" size="1">
              <option value="" {% if not city %}selected{% endif %}>All locations</option>
              {% for c in city_counts %}
                <option value="{{ c.location }}" {% if city == c.location %}selected{% endif %}>
                  {{ c.location }} ({{ c.total }})
                </option>
              {% endfor %}
            </select>
          </div>
          <div class="field">
            <label for="filter-sort">Sort by</label>
            <select id="filter-sort" name="sort_by">
              <option value="date" {% if sort_by == 'date' %}selected{% endif %}>Date posted</option>
              <option value="facility" {% if sort_by == 'facility' %}selected{% endif %}>Employer name</option>
              <option value="title" {% if sort_by == 'title' %}selected{% endif %}>Job title</option>
            </select>
          </div>
          <div class="field">
            <label for="filter-order">Order</label>
            <select id="filter-order" name="sort_order">
              <option value="desc" {% if sort_order == 'desc' %}selected{% endif %}>Newest first</option>
              <option value="asc" {% if sort_order == 'asc' %}selected{% endif %}>Oldest first</option>
            </select>
          </div>
        </div>
        <div class="filter-actions">
          <button class="btn btn--primary" type="submit">Apply filters</button>
          <a class="btn btn--secondary" href="{{ clearFiltersHref }}">Reset filters</a>
        </div>
      </div>
    </form>

    <div class="results-meta">
      <h2>Open listings</h2>
      <p>
        {% if total_filtered %}
          <strong>{{ total_filtered }}</strong> role{% if total_filtered == 1 %}{% else %}s{% endif %} match
          {% if jobRows | length %}
            · showing {{ jobRows | length }} on this page
            {% if pagination and pagination.totalPages > 1 %}
              (page {{ pagination.currentPage }} of {{ pagination.totalPages }})
            {% endif %}
          {% endif %}
        {% else %}
          No matching listings
        {% endif %}
      </p>
    </div>

    <ul class="job-list">
      {% if jobRows | length %}
        {% for job in jobRows %}
          <li class="job-card"
              tabindex="0"
              role="button"
              aria-haspopup="dialog"
              data-title="{{ job.title }}"
              data-org="{{ job.hospital_name }}"
              data-location="{{ job.location }}"
              data-date="{{ job.posted_date }}"
              data-url="{{ job.job_url }}"
              data-desc="{{ job.description | default('') }}">
            <div class="job-card__top">
              <span class="job-card__avatar" aria-hidden="true">{{ (job.hospital_name | default('') | first | default('?')) | upper }}</span>
              <div class="job-card__heading">
                <h3 class="job-card__title">{{ job.title }}</h3>
                <p class="job-card__org">{{ job.hospital_name }}</p>
              </div>
              <svg class="job-card__chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M9 18l6-6-6-6" />
              </svg>
            </div>
            <div class="job-card__meta">
              {% if job.location %}
                <span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11z" /><circle cx="12" cy="10" r="2.5" /></svg>
                  {{ job.location }}
                </span>
              {% endif %}
              {% if job.posted_date %}
                <span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M3 9h18M8 2v4M16 2v4" /></svg>
                  Posted {{ job.posted_date }}
                </span>
              {% endif %}
            </div>
            <p class="job-card__desc">
              {% if job.description %}
                {{ job.description }}
              {% else %}
                Full description and application steps are on the employer’s career portal.
              {% endif %}
            </p>
            <div class="job-card__actions">
              {% if job.job_url %}
                <a class="btn-apply" href="{{ job.job_url }}" target="_blank" rel="noopener noreferrer">
                  Apply on employer site
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3" />
                  </svg>
                </a>
              {% else %}
                <span class="btn-apply btn-apply--disabled">Application link unavailable</span>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      {% else %}
        <li class="empty-state">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.35-4.35" /></svg>
          <p>No jobs match your search or filters. Try broadening your criteria or clearing filters.</p>
        </li>
      {% endif %}
    </ul>

    {% if pagination and pagination.totalPages > 1 %}
      <nav class="pagination" aria-label="Pagination">
        {% if pagination.hasPrevious %}
          <a href="{{ pagination.prevHref }}">Previous</a>
        {% endif %}
        {% for link in pagination.pageLinks %}
          {% if link.current %}
            <span class="pagination__current" aria-current="page">{{ link.num }}</span>
          {% else %}
            <a href="{{ link.href }}">{{ link.num }}</a>
          {% endif %}
        {% endfor %}
        {% if pagination.hasNext %}
          <a href="{{ pagination.nextHref }}">Next</a>
        {% endif %}
      </nav>
    {% endif %}
  </main>

  <footer class="site-footer">
    <div class="site-footer__inner">
      <span>UAE Medical Jobs · listings link to third-party employers</span>
      <a href="https://www.linkedin.com" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </footer>

  <div class="modal-overlay" id="jobModalOverlay" hidden>
    <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="modalJobTitle">
      <button type="button" class="modal-close" id="modalCloseBtn" aria-label="Close job details">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" /></svg>
      </button>
      <div class="modal-header">
        <span class="modal-avatar" id="modalJobAvatar" aria-hidden="true"></span>
        <div>
          <h3 class="modal-job-title" id="modalJobTitle"></h3>
          <p class="modal-job-org" id="modalJobOrg"></p>
        </div>
      </div>
      <div class="modal-meta">
        <span id="modalJobLocation" hidden>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11z" /><circle cx="12" cy="10" r="2.5" /></svg>
          <span class="modal-meta__text"></span>
        </span>
        <span id="modalJobDate" hidden>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M3 9h18M8 2v4M16 2v4" /></svg>
          <span class="modal-meta__text"></span>
        </span>
      </div>
      <div class="modal-body">
        <h4>Job description</h4>
        <p id="modalJobDesc"></p>
      </div>
      <div class="modal-footer">
        <a id="modalApplyLink" class="btn-apply" target="_blank" rel="noopener noreferrer">
          Apply on employer site
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <script src="/static/js/app.js" defer></script>
</body>
</html>
