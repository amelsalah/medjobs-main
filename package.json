{
  "name": "medjobs",
  "private": true,
  "description": "Fastify app in ./src. Default DB is SQLite (./prisma/dev.db). Use PostgreSQL by changing prisma/schema.prisma + DATABASE_URL.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "setup": "prisma generate && prisma db push",
    "db:migrate": "prisma migrate dev",
    "fetch:jobs": "node scripts/fetch-jobs.js",
    "data:from-numbers": "python3 scripts/rebuild-hospitals-json.py"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "@fastify/view": "^10.0.0",
    "@prisma/client": "^6.7.0",
    "cheerio": "^1.0.0-rc.12",
    "fastify": "^5.2.0",
    "node-cron": "^4.2.1",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "prisma": "^6.7.0"
  }
}
