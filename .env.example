# SQLite (default — works without Docker or Postgres)
DATABASE_URL="file:./prisma/dev.db"
PORT=3000

# Job sync scheduler (runs inside npm run dev / npm start)
SYNC_SCHEDULER=true
SYNC_ON_START=true
SYNC_CRON="0 * * * *"

# PostgreSQL (when you install Postgres locally or on a host):
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/medjobs?schema=public"
# Then in prisma/schema.prisma set: provider = "postgresql"
# and run: npx prisma db push   (or migrate)
